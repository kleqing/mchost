#!/usr/bin/env bash
set -e

sudo apt update -qq
sudo apt install -y -qq jq curl

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SERVER_DIR="$MAIN_DIR/server"

mkdir -p "$SERVER_DIR"
cd "$SERVER_DIR"

VERSION_MANIFEST_URL="https://launchermeta.mojang.com/mc/game/version_manifest.json"
VERSION_MANIFEST="$(curl -fsSL "$VERSION_MANIFEST_URL")"
LATEST_VERSION="$(echo "$VERSION_MANIFEST" | jq -r '.latest.release')"
LATEST_SNAPSHOT_VERSION="$(echo "$VERSION_MANIFEST" | jq -r '.latest.snapshot')"

echo "> Latest release: $LATEST_VERSION"
echo "> Latest snapshot: $LATEST_SNAPSHOT_VERSION"

if [ -f "$MAIN_DIR/.mc_version" ]; then
    VANILLA_VERSION="$(tr -d '\r\n' < "$MAIN_DIR/.mc_version")"
    echo "> Using Minecraft version from installer: $VANILLA_VERSION"
else
    read -r -p "> Enter Minecraft version (latest/snapshot/version): " VANILLA_VERSION
    VANILLA_VERSION="${VANILLA_VERSION:-latest}"
fi

case "$VANILLA_VERSION" in
    latest) TARGET_VERSION="$LATEST_VERSION" ;;
    snapshot) TARGET_VERSION="$LATEST_SNAPSHOT_VERSION" ;;
    *) TARGET_VERSION="$VANILLA_VERSION" ;;
esac

MANIFEST_URL="$(echo "$VERSION_MANIFEST" | jq -r --arg VERSION "$TARGET_VERSION" '.versions[] | select(.id == $VERSION) | .url' | head -n 1)"

if [ -z "$MANIFEST_URL" ] || [ "$MANIFEST_URL" = "null" ]; then
    echo "> Invalid Minecraft version: $TARGET_VERSION"
    exit 1
fi

DOWNLOAD_URL="$(curl -fsSL "$MANIFEST_URL" | jq -r '.downloads.server.url // empty')"
if [ -z "$DOWNLOAD_URL" ]; then
    echo "> No dedicated server download exists for Minecraft $TARGET_VERSION."
    exit 1
fi

echo "> Downloading Minecraft $TARGET_VERSION server.jar..."
curl -fL "$DOWNLOAD_URL" -o server.jar

echo "eula=true" > eula.txt
echo "> Vanilla installation complete."
