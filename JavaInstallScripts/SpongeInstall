#!/usr/bin/env bash
set -e

sudo apt update -qq
sudo apt install -y -qq wget

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SERVER_DIR="$MAIN_DIR/server"

mkdir -p "$SERVER_DIR"
cd "$SERVER_DIR"

# This repository currently carries the legacy SpongeVanilla 1.12.2 installer.
# Keep it as a jar-based server so the shared startJavaServer can launch it.
wget -q -O server.jar \
    "https://repo.spongepowered.org/maven/org/spongepowered/spongevanilla/1.12.2-7.3.0/spongevanilla-1.12.2-7.3.0.jar"

echo "eula=true" > eula.txt
echo "> SpongeVanilla installation complete."
