#!/usr/bin/env bash
set -e

sudo apt update -qq
sudo apt install -y -qq jq curl

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SERVER_DIR="$MAIN_DIR/server"
JAVA="$MAIN_DIR/bin/java_bins/bin/java"
PROMOTIONS_URL="https://files.minecraftforge.net/maven/net/minecraftforge/forge/promotions_slim.json"
FILE_SITE="https://maven.minecraftforge.net/net/minecraftforge/forge"

mkdir -p "$SERVER_DIR"
cd "$SERVER_DIR"

echo "> Fetching Forge versions data..."
JSON_DATA="$(curl -fsSL "$PROMOTIONS_URL")"

echo
echo "> Enter Forge build type (default 1):"
echo "Type [1] recommended"
echo "Type [2] latest"
read -r BUILD_TYPE_CHOICE
BUILD_TYPE_CHOICE="${BUILD_TYPE_CHOICE:-1}"

case "$BUILD_TYPE_CHOICE" in
    1) BUILD_TYPE="recommended" ;;
    2) BUILD_TYPE="latest" ;;
    *)
        echo "> Invalid Forge build type."
        exit 1
        ;;
esac

if [ -f "$MAIN_DIR/.mc_version" ]; then
    MC_VERSION="$(tr -d '\r\n' < "$MAIN_DIR/.mc_version")"
    echo "> Using Minecraft version from installer: $MC_VERSION"
else
    read -r -p "> Enter Minecraft version (or 'latest'): " MC_VERSION
    MC_VERSION="${MC_VERSION:-latest}"
fi

if [ "$MC_VERSION" = "latest" ]; then
    MC_VERSION="$(echo "$JSON_DATA" | jq -r '.promos | keys[]' | sed -n 's/-latest$//p' | sort -V | tail -n 1)"
fi

resolve_forge_version() {
    local type="$1"
    local key="${MC_VERSION}-${type}"
    echo "$JSON_DATA" | jq -r --arg key "$key" '.promos[$key] // empty'
}

FORGE_VERSION="$(resolve_forge_version "$BUILD_TYPE")"

# Many Minecraft releases do not have a recommended Forge build. If the user
# chose recommended, fall back to latest for that exact Minecraft version.
if [ -z "$FORGE_VERSION" ] && [ "$BUILD_TYPE" = "recommended" ]; then
    echo "> No recommended Forge build for Minecraft $MC_VERSION; falling back to latest."
    BUILD_TYPE="latest"
    FORGE_VERSION="$(resolve_forge_version "$BUILD_TYPE")"
fi

if [ -z "$FORGE_VERSION" ]; then
    echo "> No Forge build found for Minecraft $MC_VERSION."
    exit 1
fi

echo "> Minecraft version: $MC_VERSION"
echo "> Forge version: $FORGE_VERSION ($BUILD_TYPE)"

if [ "$MC_VERSION" = "1.7.10" ] || [ "$MC_VERSION" = "1.8.9" ]; then
    BASE_NAME="forge-${MC_VERSION}-${FORGE_VERSION}-${MC_VERSION}"
    VERSION_DIR="${MC_VERSION}-${FORGE_VERSION}-${MC_VERSION}"
else
    BASE_NAME="forge-${MC_VERSION}-${FORGE_VERSION}"
    VERSION_DIR="${MC_VERSION}-${FORGE_VERSION}"
fi

INSTALLER_URL="$FILE_SITE/$VERSION_DIR/${BASE_NAME}-installer.jar"

echo "> Downloading Forge installer..."
curl -fSL "$INSTALLER_URL" -o installer.jar

echo "> Installing Forge server..."
"$JAVA" -jar installer.jar --installServer
rm -f installer.jar

echo "eula=true" > eula.txt

if [ -f "run.sh" ]; then
    # Modern Forge: keep the official generated launcher. startJavaServer
    # prepends our bundled JDK to PATH and invokes this run.sh directly.
    chmod +x run.sh

    if [ -f "user_jvm_args.txt" ]; then
        mem_kb=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)
        mem_total_gb=$((mem_kb / 1024 / 1024))
        mem_gb=$((mem_total_gb - 1))
        if [ "$mem_gb" -lt 1 ]; then
            mem_gb=1
        fi

        if ! grep -Eq '^[[:space:]]*-Xms' user_jvm_args.txt; then
            printf '%s\n' '' '# Default memory values added by mchost. Edit these if you want a custom limit.' '-Xms1G' >> user_jvm_args.txt
        fi
        if ! grep -Eq '^[[:space:]]*-Xmx' user_jvm_args.txt; then
            printf -- '-Xmx%sG\n' "$mem_gb" >> user_jvm_args.txt
        fi
    fi

    echo "> Modern Forge launcher installed (run.sh + user_jvm_args.txt)."
else
    # Older Forge versions are launched directly as a jar. Normalize the jar
    # name so startJavaServer can use the same generic path as Vanilla/Paper.
    if [ "$MC_VERSION" = "1.7.10" ] || [ "$MC_VERSION" = "1.8.9" ]; then
        FORGE_JAR="forge-${MC_VERSION}-${FORGE_VERSION}-${MC_VERSION}-universal.jar"
    else
        FORGE_JAR="forge-${MC_VERSION}-${FORGE_VERSION}.jar"
    fi

    if [ ! -f "$FORGE_JAR" ]; then
        echo "> Could not find the legacy Forge server jar: $FORGE_JAR"
        exit 1
    fi

    mv -f "$FORGE_JAR" server.jar
    echo "> Legacy Forge server installed as server.jar."
fi

echo "> Forge installation complete."
