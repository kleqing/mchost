#!/usr/bin/env bash
set -e

sudo apt update -qq
sudo apt install -y -qq curl jq unzip wget

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SERVER_DIR="$MAIN_DIR/server"
JAVA="$MAIN_DIR/bin/java_bins/bin/java"

mkdir -p "$SERVER_DIR"
cd "$SERVER_DIR"

echo "> Fetching NeoForge versions data..."

if [ -f "$MAIN_DIR/.mc_version" ]; then
    MC_VERSION="$(tr -d '\r\n' < "$MAIN_DIR/.mc_version")"
    echo "> Using Minecraft version from installer: $MC_VERSION"
else
    read -r -p "> Enter Minecraft version: " MC_VERSION
fi

if [ -z "$MC_VERSION" ] || [ "$MC_VERSION" = "latest" ]; then
    echo "> NeoForge needs an explicit Minecraft version (for example 1.21.1)."
    echo "> Re-run './install' and enter the Minecraft version you want."
    exit 1
fi

VERSIONS_JSON="$(curl -fsSL https://maven.neoforged.net/api/maven/versions/releases/net/neoforged/neoforge)"

# NeoForge 1.20.2+ uses version families derived from Minecraft:
#   Minecraft 1.21.1 -> NeoForge 21.1.x
#   Minecraft 1.20.4 -> NeoForge 20.4.x
# Newer year-based Minecraft versions can be used directly (e.g. 26.1 -> 26.1.x).
if [[ "$MC_VERSION" == 1.* ]]; then
    NEOFORGE_PREFIX="${MC_VERSION#1.}"
else
    NEOFORGE_PREFIX="$MC_VERSION"
fi

LATEST_NEOFORGE="$(echo "$VERSIONS_JSON" \
    | jq -r '.versions[]' \
    | grep -E "^${NEOFORGE_PREFIX//./\\.}\\." \
    | grep -v -- '-beta' \
    | sort -V \
    | tail -n 1 || true)"

if [ -z "$LATEST_NEOFORGE" ]; then
    LATEST_NEOFORGE="$(echo "$VERSIONS_JSON" \
        | jq -r '.versions[]' \
        | grep -E "^${NEOFORGE_PREFIX//./\\.}\\." \
        | sort -V \
        | tail -n 1 || true)"
fi

if [ -z "$LATEST_NEOFORGE" ]; then
    echo "> Could not find a NeoForge version matching Minecraft $MC_VERSION."
    echo "> This installer targets the modern NeoForge version scheme (1.20.2+)."
    exit 1
fi

echo "> Selected NeoForge version: $LATEST_NEOFORGE"
INSTALLER_URL="https://maven.neoforged.net/releases/net/neoforged/neoforge/${LATEST_NEOFORGE}/neoforge-${LATEST_NEOFORGE}-installer.jar"

echo "> Downloading NeoForge installer..."
curl -fSL "$INSTALLER_URL" -o installer.jar

echo "> Installing NeoForge server..."
"$JAVA" -jar installer.jar --installServer
rm -f installer.jar

echo "eula=true" > eula.txt

if [ ! -f "run.sh" ]; then
    echo "> NeoForge installer completed but run.sh was not generated."
    exit 1
fi

# Keep NeoForge's official generated launcher untouched.
chmod +x run.sh

if [ -f "user_jvm_args.txt" ]; then
    mem_kb=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)
    mem_total_gb=$((mem_kb / 1024 / 1024))
    mem_gb=$((mem_total_gb - 1))
    if [ "$mem_gb" -lt 1 ]; then
        mem_gb=1
    fi

    if ! grep -Eq '^[[:space:]]*-Xms' user_jvm_args.txt; then
        printf '%s\n' '' '# Default memory values added by mchost. Edit these if you want a custom limit.' '-Xms1G' >> user_jvm_args.txt
    fi
    if ! grep -Eq '^[[:space:]]*-Xmx' user_jvm_args.txt; then
        printf -- '-Xmx%sG\n' "$mem_gb" >> user_jvm_args.txt
    fi
fi

echo "> NeoForge installation complete (run.sh + user_jvm_args.txt)."
