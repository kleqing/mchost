#!/usr/bin/env bash
set -e

sudo apt update -qq
sudo apt install -y -qq curl jq >/dev/null

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SERVER_DIR="$MAIN_DIR/server"
PROJECT="paper"
USER_AGENT="mchost-shell/1.0 (https://github.com/lordofwizard/mcserver)"
API_BASE="https://fill.papermc.io/v3"

mkdir -p "$SERVER_DIR"
cd "$SERVER_DIR"

if [ -f "$MAIN_DIR/.mc_version" ]; then
    MINECRAFT_VERSION="$(tr -d '\r\n' < "$MAIN_DIR/.mc_version")"
    echo "> Using Minecraft version from installer: $MINECRAFT_VERSION"
else
    read -r -p "> Enter Minecraft version for server: " MINECRAFT_VERSION
fi

PROJECT_INFO="$(curl -fsSL -H "User-Agent: $USER_AGENT" "$API_BASE/projects/$PROJECT")"

if ! echo "$PROJECT_INFO" | jq -e --arg VERSION "$MINECRAFT_VERSION" '[.versions[][]] | index($VERSION) != null' >/dev/null; then
    echo "> Paper does not provide Minecraft $MINECRAFT_VERSION."
    exit 1
fi

BUILDS_RESPONSE="$(curl -fsSL -H "User-Agent: $USER_AGENT" \
    "$API_BASE/projects/$PROJECT/versions/$MINECRAFT_VERSION/builds")"

DOWNLOAD_URL="$(echo "$BUILDS_RESPONSE" | jq -r 'first(.[] | select(.channel == "STABLE") | .downloads."server:default".url) // empty')"
BUILD_ID="$(echo "$BUILDS_RESPONSE" | jq -r 'first(.[] | select(.channel == "STABLE") | .id) // empty')"

if [ -z "$DOWNLOAD_URL" ]; then
    echo "> No stable Paper build found for Minecraft $MINECRAFT_VERSION."
    exit 1
fi

echo "> Downloading Paper $MINECRAFT_VERSION build $BUILD_ID..."
if [ -f server.jar ]; then
    mv -f server.jar server.jar.old
fi
curl -fL -H "User-Agent: $USER_AGENT" "$DOWNLOAD_URL" -o server.jar

echo "eula=true" > eula.txt
echo "> Paper installation complete."
