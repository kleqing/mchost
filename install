#!/usr/bin/env bash
set -e

MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "$MAIN_DIR/bin"
chmod +x "$MAIN_DIR"/* 2>/dev/null || true

echo "Which Server do you want to install?"
echo "Type [1] Java Server"
echo "Type [2] Bedrock Server"
echo
read -r -p "> Enter your choice (1 or 2): " choiceForServer

case "$choiceForServer" in
    1)
        sudo apt install -y -qq curl jq wget tar

        echo
        read -r -p "> Enter Minecraft version (e.g., 1.21.1, 1.20.4, 26.1, latest): " MC_VERSION
        MC_VERSION="${MC_VERSION:-latest}"

        # Resolve aliases now so every Java installer works with one concrete
        # Minecraft version and Java selection remains correct as 'latest' moves.
        VERSION_MANIFEST="$(curl -fsSL https://launchermeta.mojang.com/mc/game/version_manifest.json)"
        case "$MC_VERSION" in
            latest)
                MC_VERSION="$(echo "$VERSION_MANIFEST" | jq -r '.latest.release')"
                ;;
            snapshot)
                MC_VERSION="$(echo "$VERSION_MANIFEST" | jq -r '.latest.snapshot')"
                ;;
        esac

        if ! echo "$VERSION_MANIFEST" | jq -e --arg VERSION "$MC_VERSION" '.versions[] | select(.id == $VERSION)' >/dev/null; then
            echo "> Minecraft version '$MC_VERSION' was not found in Mojang's version manifest."
            exit 1
        fi

        echo "$MC_VERSION" > "$MAIN_DIR/.mc_version"

        # Runtime selection for the Minecraft generations supported by the repo.
        # 26.1+ uses Java 25, 1.20.5-1.21.x uses Java 21,
        # 1.18-1.20.4 uses Java 17, 1.17 uses Java 16, older uses Java 8.
        if [[ "$MC_VERSION" != 1.* ]]; then
            JAVA_VER=25
        elif [ "$(printf '%s\n' "1.20.5" "$MC_VERSION" | sort -V | head -n1)" = "1.20.5" ]; then
            JAVA_VER=21
        elif [ "$(printf '%s\n' "1.18" "$MC_VERSION" | sort -V | head -n1)" = "1.18" ]; then
            JAVA_VER=17
        elif [ "$(printf '%s\n' "1.17" "$MC_VERSION" | sort -V | head -n1)" = "1.17" ]; then
            JAVA_VER=16
        else
            JAVA_VER=8
        fi

        echo "> Resolved Minecraft version: $MC_VERSION"
        echo "> Selected Java $JAVA_VER"

        cd "$MAIN_DIR/bin"
        rm -rf java_bins java.tar.gz
        rm -rf jdk-*

        wget -q --show-progress -O java.tar.gz \
            "https://api.adoptium.net/v3/binary/latest/${JAVA_VER}/ga/linux/x64/jdk/hotspot/normal/eclipse"

        echo "> Extracting Java JDK $JAVA_VER to bin/java_bins..."
        TOP_DIR="$(tar -tzf java.tar.gz | head -n1 | cut -d/ -f1)"
        tar -xzf java.tar.gz
        mv "$TOP_DIR" java_bins
        rm -f java.tar.gz

        cd "$MAIN_DIR"
        echo "> Running Java installation..."
        ./installJava
        ;;

    2)
        cd "$MAIN_DIR"
        echo "> Running Bedrock installation..."
        ./installBedrock
        ;;

    *)
        echo "> Invalid response. Please run './install' again and choose 1 or 2."
        exit 1
        ;;
esac

echo "> Installing AFK (Away From Keyboard)..."
if python3 -m pip install --user --disable-pip-version-check -q bpytop >/dev/null 2>&1; then
    echo "> AFK dependency installed successfully."
else
    echo "> Failed to install AFK dependency."
fi

echo
