#!/bin/bash
mkdir bin
chmod +x *
export MAIN_DIR=$PWD
echo "Which Server do you want to install?"
echo "Type [1] Java Server"
echo "Type [2] Bedrock Server"
echo ""
read -p "> Enter your choice (1 or 2): " choiceForServer

# Installing JDK and playit
if [[ -z $choiceForServer || $choiceForServer == 1 ]]; then
    echo ""
    echo "> Enter Minecraft version (e.g., 1.21.1, 1.20.4, 1.16.5, 26.1): "
    read -p "> " MC_VERSION
    if [[ -z $MC_VERSION ]]; then
        MC_VERSION="latest"
    fi
    echo "$MC_VERSION" > $MAIN_DIR/.mc_version

    # Auto-detect Java version
    JAVA_VER=21
    if [[ "$MC_VERSION" == "latest" || "$MC_VERSION" == "snapshot" ]]; then
        JAVA_VER=21
    elif [ "$(printf '%s\n' "26.1" "$MC_VERSION" | sort -V | head -n1)" = "26.1" ]; then
        JAVA_VER=25
    elif [ "$(printf '%s\n' "1.20.5" "$MC_VERSION" | sort -V | head -n1)" = "1.20.5" ]; then
        JAVA_VER=21
    elif [ "$(printf '%s\n' "1.17" "$MC_VERSION" | sort -V | head -n1)" = "1.17" ]; then
        JAVA_VER=17
    else
        JAVA_VER=8
    fi

    echo "> Selected Java $JAVA_VER for Minecraft $MC_VERSION"
    cd $MAIN_DIR/bin
    wget -q --show-progress -O java.tar.gz "https://api.adoptium.net/v3/binary/latest/${JAVA_VER}/ga/linux/x64/jdk/hotspot/normal/eclipse"
    echo "> Extracting Java JDK $JAVA_VER to the bin/ folder. [THIS MAY TAKE SOME TIME]"
    tar -xzf java.tar.gz
    DIR_NAME=$(ls -d jdk* | head -n 1)
    mv "$DIR_NAME" java_bins
    cd $MAIN_DIR
fi

cd $MAIN_DIR
# If choice is 0 or null then run this command
if [[ -z $choiceForServer ]]; then

  echo "> Invaild Respond. Please try again."
  ./install

# If choice is 1 then run this command
elif [[ $choiceForServer == 1 ]]; then
	
	echo "> Running Java Installation..."
  ./installJava

# If choice is 1 then run this command
elif [[ $choiceForServer == 2 ]]; then
	
	echo "> Running Bedrock Installation..."
  ./installBedrock

else
	echo "> Invaild Respond. Please try again."
	./install
fi
echo "> Installing AFK(Away From Keyboard) Script "
python3 -m pip install bpytop
echo ""

