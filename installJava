#!/usr/bin/env bash
set -e

THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$THIS_DIR/JavaInstallScripts"
SERVER_TYPE_FILE="$THIS_DIR/.server_type"

sudo apt install -y -qq screen neofetch

echo "> Dependencies installation completed!"
echo
echo "-- Pick the following server type: --"
echo "Type [1] Create Vanilla Server"
echo "Type [2] Create Paper Server"
echo "Type [3] Create Forge Server"
echo "Type [4] Create Sponge Server"
echo "Type [5] Create Fabric Server"
echo "Type [6] Create Spigot Server (compile)"
echo "Type [7] Create BungeeCord Server (latest)"
echo "Type [8] Create NeoForge Server"
echo
read -r -p "> Enter your choice (1-8): " choiceForServer

# Preserve the original behaviour: pressing Enter installs Vanilla.
if [ -z "$choiceForServer" ]; then
    choiceForServer=1
fi

case "$choiceForServer" in
    1) SERVER_TYPE="vanilla";   INSTALLER="VanillaInstall" ;;
    2) SERVER_TYPE="paper";     INSTALLER="PaperInstall" ;;
    3) SERVER_TYPE="forge";     INSTALLER="ForgeInstall" ;;
    4) SERVER_TYPE="sponge";    INSTALLER="SpongeInstall" ;;
    5) SERVER_TYPE="fabric";    INSTALLER="FabricInstall" ;;
    6) SERVER_TYPE="spigot";    INSTALLER="SpigotInstall" ;;
    7) SERVER_TYPE="bungeecord"; INSTALLER="BungeecordInstall" ;;
    8) SERVER_TYPE="neoforge";  INSTALLER="NeoForgeInstall" ;;
    *)
        echo "> Invalid response. Please run './installJava' again and choose 1-8."
        exit 1
        ;;
esac

echo "> Installing $SERVER_TYPE..."
chmod +x "$SCRIPTS_DIR"/*
(
    cd "$SCRIPTS_DIR"
    "./$INSTALLER"
)

# Only persist the type after the installer succeeds.
echo "$SERVER_TYPE" > "$SERVER_TYPE_FILE"
echo "> Saved server type: $SERVER_TYPE"

# Backup install of playit.gg in case it was not installed earlier.
echo "> Installing Playit.gg..."
cd "$THIS_DIR"
./installPlayIt

echo
echo "-- Do you want to start the server now? --"
echo "Type [1] for Yes"
echo "Type [2] for No"
read -r StartServer

case "$StartServer" in
    1)
        ./startserver
        ;;
    2|"")
        echo "> You can start the server with './startserver'."
        ;;
    *)
        echo "> Unknown choice; not starting automatically."
        echo "> You can start the server with './startserver'."
        ;;
esac
