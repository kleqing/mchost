#!/usr/bin/env bash

export MAIN_DIR="$PWD"
SERVER_DIR="$MAIN_DIR/server"

echo "> Starting the server up. Please wait..."
echo "> Installing dependencies..."

sudo apt install -y -qq screen wget

echo "> Dependencies installed!"
echo "> Checking server type..."

detect_server_type() {
    if [ -f "$SERVER_DIR/bedrock_server" ]; then
        echo "bedrock-vanilla"
    elif [ -f "$SERVER_DIR/PocketMine-MP.phar" ]; then
        echo "bedrock-pocketmine"
    elif [ -f "$SERVER_DIR/nukkit.yml" ] && [ -f "$SERVER_DIR/server.jar" ]; then
        echo "bedrock-nukkit"
    elif [ -d "$SERVER_DIR/modules" ] && [ -f "$SERVER_DIR/server.yml" ]; then
        echo "bedrock-gomint"
    elif [ -f "$SERVER_DIR/eula.txt" ] \
        || [ -f "$SERVER_DIR/server.jar" ] \
        || [ -f "$SERVER_DIR/fabric-server-launch.jar" ] \
        || [ -f "$SERVER_DIR/run.sh" ]; then
        echo "java"
    else
        echo "unknown"
    fi
}

SERVER_TYPE="$(detect_server_type)"

case "$SERVER_TYPE" in
    bedrock-vanilla)
        echo "> Bedrock Dedicated Server detected!"
        ;;
    bedrock-pocketmine)
        echo "> PocketMine-MP server detected!"
        ;;
    bedrock-nukkit)
        echo "> Nukkit server detected!"
        ;;
    bedrock-gomint)
        echo "> GoMint server detected!"
        ;;
    java)
        echo "> Java server detected!"
        ;;
    *)
        echo "> Could not detect a valid Minecraft server installation."
        echo "> Run './install' to install a server, or './uninstall' first if you want a clean reinstall."
        exit 1
        ;;
esac

# Prevent duplicate project sessions without killing unrelated screen sessions.
screen -S server -X quit 2>/dev/null || true
screen -S playit -X quit 2>/dev/null || true
screen -S afk -X quit 2>/dev/null || true

# Start exactly one Minecraft server implementation.
case "$SERVER_TYPE" in
    java)
        screen -S server -d -m ./startJavaServer
        ;;
    bedrock-*)
        screen -S server -d -m ./startBedrockServer "$SERVER_TYPE"
        ;;
esac

# Start AFK helper and Playit tunnel.
screen -S afk -d -m ./startAfk
screen -S playit -d -m ./startPlayIt

echo
echo "-- Your Server is now ONLINE! --"
echo
echo "Type [screen -ls] to check the running processes"
echo "Type [screen -r server] to enter the Server Console"
echo "Type [screen -r playit] to view Playit"
echo "Type [screen -r afk] to enter AFK mode"
echo "Please keep the terminal/browser session alive and leave AFK mode running if your host requires it."
echo "If Playit doesn't start, run './installPlayIt' then './startPlayIt'."
echo
echo "> To stop your server, type './stopserver'"
echo "> To exit a screen without stopping it, press Ctrl+A then D"

echo -e '\n> Checking if server launched properly...'
./.checkserver 2> crash.log
