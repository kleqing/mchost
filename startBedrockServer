#!/usr/bin/env bash

MAIN_DIR="${MAIN_DIR:-$PWD}"
SERVER_DIR="$MAIN_DIR/server"
SERVER_TYPE="${1:-}"

cd "$SERVER_DIR" || {
    echo "Server directory not found: $SERVER_DIR" >&2
    exit 1
}

# Allow this script to be launched directly as well as through ./startserver.
if [ -z "$SERVER_TYPE" ]; then
    if [ -f "bedrock_server" ]; then
        SERVER_TYPE="bedrock-vanilla"
    elif [ -f "PocketMine-MP.phar" ]; then
        SERVER_TYPE="bedrock-pocketmine"
    elif [ -f "nukkit.yml" ] && [ -f "server.jar" ]; then
        SERVER_TYPE="bedrock-nukkit"
    elif [ -d "modules" ] && [ -f "server.yml" ]; then
        SERVER_TYPE="bedrock-gomint"
    else
        echo "Unable to detect a supported Bedrock server implementation." >&2
        exit 1
    fi
fi

find_java() {
    if [ -x "$MAIN_DIR/bin/java_bins/bin/java" ]; then
        printf '%s\n' "$MAIN_DIR/bin/java_bins/bin/java"
    elif command -v java >/dev/null 2>&1; then
        command -v java
    else
        return 1
    fi
}

case "$SERVER_TYPE" in
    bedrock-vanilla)
        chmod +x ./bedrock_server
        exec env LD_LIBRARY_PATH=".${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ./bedrock_server
        ;;

    bedrock-pocketmine)
        PHP_BIN=""
        for candidate in \
            "./bin/php7/bin/php" \
            "./bin/php/bin/php" \
            "./bin/php"; do
            if [ -x "$candidate" ]; then
                PHP_BIN="$candidate"
                break
            fi
        done

        if [ -z "$PHP_BIN" ] && command -v php >/dev/null 2>&1; then
            PHP_BIN="$(command -v php)"
        fi

        if [ -z "$PHP_BIN" ]; then
            echo "PocketMine-MP detected, but no PHP executable was found." >&2
            exit 1
        fi

        exec "$PHP_BIN" ./PocketMine-MP.phar --no-wizard --disable-ansi
        ;;

    bedrock-nukkit)
        JAVA="$(find_java)" || {
            echo "Nukkit detected, but Java is not installed or not available in PATH." >&2
            exit 1
        }
        exec "$JAVA" -jar ./server.jar
        ;;

    bedrock-gomint)
        JAVA="$(find_java)" || {
            echo "GoMint detected, but Java is not installed or not available in PATH." >&2
            exit 1
        }
        exec "$JAVA" \
            --add-opens java.base/java.nio=io.netty.common \
            --add-exports java.base/jdk.internal.misc=io.netty.common \
            -p modules \
            -m gomint.server/io.gomint.server.Bootstrap
        ;;

    *)
        echo "Unsupported Bedrock server type: $SERVER_TYPE" >&2
        exit 1
        ;;
esac
